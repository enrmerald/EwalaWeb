# Copia este archivo a .env.local (está en .gitignore: NUNCA se sube al repositorio).
# En Netlify, estas variables se definen en Site configuration → Environment variables.

# ── Formulario de contacto → Microsoft Graph (netlify/functions/contact.mts) ──────────────────────────
# Solo los lee la función (servidor), nunca el navegador: por eso NO llevan el prefijo NEXT_PUBLIC_.
# Si falta alguna, la función funciona en MODO PRUEBA: valida, no envía y el formulario lo avisa.
# Para probar en local: `pnpm build` y `pnpm dlx --package=netlify-cli netlify dev --dir out`
# (netlify dev lee este fichero .env.local).
#
# GUID del tenant de Microsoft 365 (Entra ID → Overview → Tenant ID).
MS_TENANT_ID=
# GUID de la app «Web Ewala - Contacto» (App registrations → Application (client) ID).
MS_CLIENT_ID=
# Secreto de cliente de esa app (Certificates & secrets → Value). SECRETO: caduca (6 meses), ver rotación
# en docs/arquitectura.md. Nunca en código, en NEXT_PUBLIC_* ni en el chat.
MS_CLIENT_SECRET=
# Buzón compartido desde el que se envía, p. ej.: web@ewala.es. Es el ÚNICO buzón como el que la app puede
# enviar (RBAC for Applications de Exchange): si pones otro, Graph responde 403 y el formulario da 503.
MS_SENDER=web@ewala.es
# Buzón que recibe las consultas, p. ej.: operaciones@ewala.es
CONTACT_MAILBOX_TO=
# "production" solo en producción. Cualquier otro valor añade [VALOR] al asunto del correo.
MAIL_ENVIRONMENT=development

# ── SEO ──────────────────────────────────────────────────────────────────────────────────────
# URL pública del sitio (por defecto https://ewala.es), sin barra final (si se pone, se quita). Vacía =
# valor por defecto. Solo cambiarla para pruebas especiales.
NEXT_PUBLIC_SITE_URL=
# Código de verificación de Google Search Console por metaetiqueta (opcional: se recomienda
# verificar por DNS, que cubre todo el dominio).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Analítica ────────────────────────────────────────────────────────────────────────────────
# NO hay variables. Google Tag Manager (GTM-KG3ZWVWW) va fijo en lib/analytics.ts y
# public/gtm.js; GA4 y el banner de Cookiebot se configuran dentro del contenedor GTM.

# ── Funcionalidades ──────────────────────────────────────────────────────────────────────────
# Interruptor de la demo/PoC (lib/features.ts). Vacío o distinto de "true" = OCULTO (por defecto, porque
# la demo aún no está activa). "true" = visible. Gobierna: «Solicitar demo» del navbar (escritorio y móvil),
# «Solicita una demo» del hero, el botón principal del CTA final (oculto: pasa a «Contáctanos»), los botones
# «Descargar cómo funciona una PoC». El selector del formulario de contacto no depende de este interruptor.
# Se incrusta en build: cambiarlo exige volver a construir (pnpm build) y desplegar.
NEXT_PUBLIC_SHOW_DEMO_CTA=
